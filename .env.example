# ───────── Database (MySQL / MariaDB) ─────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuscast_db

# ───────── Server ─────────
PORT=5000
# Public address TVs use to download media (set this behind a reverse proxy / DNS name). Example: http://signage.dypiu.ac.in:5000
CAMPUSCAST_PUBLIC_URL=
# Time zone used for campaign schedules (IANA name)
CAMPUSCAST_TIMEZONE=Asia/Kolkata

# ───────── Security ─────────
# >= 16 random characters. If empty, a random secret is generated and stored in server/.auth-secret
CAMPUSCAST_AUTH_SECRET=
CAMPUSCAST_SESSION_HOURS=12
# Extra allowed browser origins (comma separated). Empty = same host name on any port.
CAMPUSCAST_CORS_ORIGINS=
# Set to 1 to require a per-screen device key on all TV endpoints
CAMPUSCAST_REQUIRE_DEVICE_KEY=0
# First-run only: password given to accounts that have no valid password. Empty = random, printed once in the console.
CAMPUSCAST_BOOTSTRAP_PASSWORD=
CAMPUSCAST_ADMIN_EMAIL=admin@dypiu.ac.in

# ───────── Uploads / monitoring ─────────
CAMPUSCAST_MAX_IMAGE_MB=20
CAMPUSCAST_MAX_VIDEO_MB=100
CAMPUSCAST_HEARTBEAT_OFFLINE_SECONDS=60
# Slack / Teams / Discord compatible webhook that receives "screen offline" alerts
CAMPUSCAST_ALERT_WEBHOOK_URL=

# ───────── Frontend (Vite dev only) ─────────
# VITE_API_BASE=http://192.168.1.10:5000/api/v1
