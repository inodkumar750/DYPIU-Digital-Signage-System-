<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F051D">

    <!-- Fullscreen Signage Kiosk Player -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Connection Retry Overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE0F051D"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CampusCast TV — Connecting to Server..."
            android:textColor="#EEE3B0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Retrying automatically every 5 seconds..."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="Retry Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnOpenSetupFromError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="Server Setup"
                android:textAllCaps="false"
                android:textColor="#EEE3B0" />
        </LinearLayout>
    </LinearLayout>

    <!-- TV Setup Overlay (First launch or press Menu / 3x Back on remote) -->
    <ScrollView
        android:id="@+id/setupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F51A0B2E"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:background="#290044"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CampusCast Android TV Player"
                    android:textColor="#EEE3B0"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="D.Y. Patil International University · Standalone Kiosk Mode"
                    android:textColor="#B8A9C9"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CampusCast Server URL"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tv_input"
                    android:focusable="true"
                    android:hint="http://10.40.0.193:3000"
                    android:inputType="textUri"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:text="http://10.40.0.193:3000"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A7D96"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Select TV Screen ID"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresetSansui"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tv_button"
                        android:focusable="true"
                        android:text="DYPIU-TV-012 (Sansui)"
                        android:textAllCaps="false"
                        android:textColor="#EEE3B0"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPresetLobby"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tv_button"
                        android:focusable="true"
                        android:text="DYPIU-TV-001"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPresetStendy"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tv_button"
                        android:focusable="true"
                        android:text="DYPIU-STENDY"
                        android:textAllCaps="false"
                        android:textColor="#EEE3B0"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etScreenId"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_tv_input"
                    android:focusable="true"
                    android:hint="DYPIU-TV-012"
                    android:inputType="text"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:text="DYPIU-TV-012"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A7D96"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbAutoBoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:buttonTint="#EEE3B0"
                    android:checked="true"
                    android:focusable="true"
                    android:text="Auto-launch on TV power ON &amp; standby wake"
                    android:textColor="#EEE3B0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAutoBootStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Auto-start permission: Checking..."
                    android:textColor="#B8A9C9"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOverlayPermission"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tv_button"
                        android:focusable="true"
                        android:text="Allow Boot Auto-Open"
                        android:textAllCaps="false"
                        android:textColor="#EEE3B0"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTvHomeLauncher"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tv_button"
                        android:focusable="true"
                        android:text="Set Default TV Home"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLaunch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_tv_button"
                    android:focusable="true"
                    android:text="Save &amp; Launch Fullscreen TV Player"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tip: Set CampusCast as Default TV Home (or Allow Boot Auto-Open) so power ON launches signage with zero remote steps. Press MENU or 3x BACK to reopen setup."
                    android:textColor="#B8A9C9"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
